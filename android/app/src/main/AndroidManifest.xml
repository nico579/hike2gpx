<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi ou données mobiles : un lot ne se télécharge de lui-même que sur un réseau non facturé. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- La mise à jour depuis les releases GitHub, comme gpxelev : l'APK passe à l'installateur d'Android. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Le scanner du QR code d'un PC (zxing-android-embedded, comme watch2notif) ; un téléphone sans caméra garde le lien à coller. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Le point bleu, le recentrage et la trace GPS : la position n'est demandée
         qu'au premier appui sur un des deux boutons, pas au lancement. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- ServiceTrace : la trace continue écran éteint, avec sa notification.
         FOREGROUND_SERVICE_LOCATION est exigé depuis Android 14 pour ce type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="@string/app_name" android:icon="@drawable/hike2gpx"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">
        <provider android:name=".FournisseurMaj"
            android:authorities="${applicationId}.maj" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/maj_chemins" />
        </provider>
        <service android:name=".ServiceTrace" android:exported="false"
            android:foregroundServiceType="location" />
        <!-- configChanges : une rotation ne recrée pas l'écran pendant un téléchargement. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Le QR code d'un PC : hike2gpx://depot?url=…&jeton=…, ouvert par l'appareil photo. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hike2gpx" android:host="depot" />
            </intent-filter>
            <!-- Un GPX ou un KML ouvert depuis un gestionnaire de fichiers, une pièce
                 jointe ou un téléchargement : « Ouvrir avec hike2gpx ». -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
            </intent-filter>
            <!-- Un gestionnaire qui ignore ces types envoie application/octet-stream :
                 l'extension du nom tranche, pour ne pas proposer hike2gpx à tout fichier. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\..*\\.gpx" />
                <data android:pathPattern=".*\\.kml" />
                <data android:pathPattern=".*\\..*\\.kml" />
            </intent-filter>
            <!-- « Partager » un GPX ou un KML vers hike2gpx (depuis un courriel, une messagerie). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
            </intent-filter>
        </activity>
    </application>
</manifest>
